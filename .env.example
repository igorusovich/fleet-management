# Copy to `.env.local` for local development. Defaults in `lib/config.ts` apply
# when a variable is absent, so the app runs with no env file at all.

# --- Server ---------------------------------------------------------------
# Secret robots (and the simulator) must send as the `x-ingest-key` header.
INGEST_API_KEY=dev-ingest-key

# SQLite database file. Parent directory is created on first run.
DATABASE_PATH=./data/fleet.db

# Telemetry freshness thresholds, in milliseconds, used to derive robot status.
OFFLINE_AFTER_MS=10000
DELAYED_AFTER_MS=3000

# Battery percentage under which a robot is flagged low_battery.
LOW_BATTERY_PCT=20

# Hours of raw telemetry kept; older rows are swept on ingest.
RETENTION_HOURS=24

# --- Simulator (separate process, see PLAN.md §6) -------------------------
# SIM_URL=http://localhost:3000/api/ingest
# SIM_ROBOTS=20
# SIM_INTERVAL_MS=1000
# SIM_DROP_RATE=0.02
# SIM_SEED=42
